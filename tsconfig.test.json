{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@chief-of-staff/db/testing": [
        "./packages/db/src/testing/postgres.ts"
      ],
      "@chief-of-staff/fixtures": [
        "./fixtures/src/index.ts"
      ],
      "@chief-of-staff/*": [
        "./packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/*.config.ts",
    "fixtures/src/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    // The dashboard is checked by packages/web/tsconfig.json instead - by
    // `next build` in the gate, and by ESLint, which lists both projects.
    // Not an exemption: that config extends the same strict base, and it is the
    // only one that can hold JSX. Keeping the app here as well would pull
    // Next's global type augmentations - a required `NODE_ENV` on
    // `NodeJS.ProcessEnv`, among others - into every other package's check.
    "packages/web/src/**"
  ]
}
