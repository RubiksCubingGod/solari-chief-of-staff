{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@chief-of-staff/db/testing": [
        "./packages/db/src/testing/postgres.ts"
      ],
      "@chief-of-staff/*": [
        "./packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/*.config.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ]
}
