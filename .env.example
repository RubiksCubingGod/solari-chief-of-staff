# Copy to `.env` and adjust. Every variable the workspace reads today is here;
# later sprints add their own (Anthropic) as they land.

# --- The API server -----------------------------------------------------------

# Required. Points at the database `docker compose up` starts; the credentials
# and the default port come from docker-compose.yml.
DATABASE_URL=postgres://chief_of_staff:chief_of_staff@127.0.0.1:5432/chief_of_staff

# The interface and port the server binds. Loopback by default: nothing here is
# authenticated yet, so it should not be reachable from the network.
HOST=127.0.0.1
PORT=3000

# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# One of: development, test, production.
NODE_ENV=development

# --- Local development database -----------------------------------------------

# The host port docker-compose.yml publishes. Move it if this workstation
# already runs Postgres on 5432, and change DATABASE_URL to match.
POSTGRES_PORT=5432

# --- The dashboard ------------------------------------------------------------

# Required. The origin the dashboard reaches the API server on - HOST and PORT
# above, as a URL. It is the dashboard's only route to any data: `packages/web`
# is forbidden by lint from importing the database at all. A trailing slash is
# ignored, and anything but http or https is refused at boot.
API_BASE_URL=http://127.0.0.1:3000

# --- The Telegram bot ---------------------------------------------------------

# Required, and the one secret in this file: talk to @BotFather to mint it, then
# put the real value in `.env`, never here. The bot reads the same DATABASE_URL
# as the server above - every message it sees, in either direction, is written
# to the shared transcript.
TELEGRAM_BOT_TOKEN=

# One of: polling, webhook. Polling needs nothing reachable from the internet,
# which is why it is the default for a workstation. Webhook is for a deployment
# that has a public https URL, and reads the two variables below.
TELEGRAM_TRANSPORT=polling

# Required when TELEGRAM_TRANSPORT is webhook, ignored otherwise. Must be https:
# Telegram refuses to deliver anywhere else, so an http URL here is a bot that
# receives nothing rather than one that fails at boot.
TELEGRAM_WEBHOOK_URL=

# Optional, and worth setting in any real deployment: Telegram sends it back on
# every call, so the route can tell a real update from anyone who guessed the
# URL. Ignored while polling.
TELEGRAM_WEBHOOK_SECRET=

# The per-chat token bucket. A chat may spend BURST messages at once and earns
# PER_MINUTE more over a minute; once it runs dry every further message is
# dropped, and it is told so at most once per NOTICE_SECONDS. The refusal is
# unconditional - only the explanation is rationed, because repeating it to a
# looping script would be a second flood.
TELEGRAM_RATE_LIMIT_BURST=10
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_RATE_LIMIT_NOTICE_SECONDS=60

# --- Tests --------------------------------------------------------------------

# Leave blank. Integration tests start their own throwaway Postgres container
# per suite, which is what CI does; a machine with no container runtime falls
# back to an embedded PostgreSQL 17 cluster on its own, so nothing has to be set
# here for a fresh clone to run the suite. Set this to a server URL only to send
# every integration test at a Postgres you already run: each suite then creates
# and drops a uniquely named database on that server instead.
TEST_DATABASE_URL=

# Leave blank. Pins one rung of that ladder instead of walking it: `server`
# (requires TEST_DATABASE_URL), `container`, or `embedded`. Its use is
# reproducing what another machine does - forcing `embedded` on a workstation
# that has Docker, say - rather than configuring this one.
TEST_POSTGRES_STARTER=

# --- The browser substrate ----------------------------------------------------

# Leave blank. Only the live Solari smoke reads it, and only when opted in
# below; every other test in the workspace drives a local Chromium or an
# injected fake and needs nothing here. Put the real key in `.env`, never here -
# it bills a real account. CI reads it from the `SOLARI_API_KEY` repository
# secret, which is what the nightly `live-smoke` workflow is gated on.
SOLARI_API_KEY=

# Leave blank. The deliberate opt-in for the live smoke: a key on the machine is
# not consent to spend it, so `pnpm check` skips the live suite even where a
# valid key exists. `node scripts/live-smoke.mjs` sets this for you, which is
# the intended way to run it; setting it by hand here makes every ordinary test
# run go live. One of: 1, true, yes, on.
SOLARI_LIVE_SMOKE=
