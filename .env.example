# Copy to `.env` and adjust. Every variable the workspace reads today is here;
# later sprints add their own (Solari, Anthropic, Telegram) as they land.

# --- The API server -----------------------------------------------------------

# Required. Points at the database `docker compose up` starts; the credentials
# and the default port come from docker-compose.yml.
DATABASE_URL=postgres://chief_of_staff:chief_of_staff@127.0.0.1:5432/chief_of_staff

# The interface and port the server binds. Loopback by default: nothing here is
# authenticated yet, so it should not be reachable from the network.
HOST=127.0.0.1
PORT=3000

# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# One of: development, test, production.
NODE_ENV=development

# --- Local development database -----------------------------------------------

# The host port docker-compose.yml publishes. Move it if this workstation
# already runs Postgres on 5432, and change DATABASE_URL to match.
POSTGRES_PORT=5432

# --- Tests --------------------------------------------------------------------

# Leave blank. Integration tests start their own throwaway Postgres container
# per suite, which is what CI does. Set this to a server URL only on a machine
# with no container runtime: each suite then creates and drops a uniquely named
# database on that server instead.
TEST_DATABASE_URL=

# --- The browser substrate ----------------------------------------------------

# Leave blank. Only the live Solari smoke reads it, and only when opted in
# below; every other test in the workspace drives a local Chromium or an
# injected fake and needs nothing here. Put the real key in `.env`, never here -
# it bills a real account. CI reads it from the `SOLARI_API_KEY` repository
# secret, which is what the nightly `live-smoke` workflow is gated on.
SOLARI_API_KEY=

# Leave blank. The deliberate opt-in for the live smoke: a key on the machine is
# not consent to spend it, so `pnpm check` skips the live suite even where a
# valid key exists. `node scripts/live-smoke.mjs` sets this for you, which is
# the intended way to run it; setting it by hand here makes every ordinary test
# run go live. One of: 1, true, yes, on.
SOLARI_LIVE_SMOKE=
